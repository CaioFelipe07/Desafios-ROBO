<?xml version="1.0"?>
<sdf version="1.10"><world name="estacionamento">
  <physics name="passo" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
  <gravity>0 0 -9.8</gravity>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
  <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.85 0.9 0.95 1</background><shadows>false</shadows></scene>
  <light name="sol" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.2 -1</direction><cast_shadows>false</cast_shadows></light>
  <model name="piso"><static>true</static><link name="piso"><collision name="piso"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="piso"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link></model>
<model name="parede"><static>true</static><pose>3 0 0.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 4 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4 1.2</size></box></geometry><material><ambient>0.85 0.25 0.15 1</ambient><diffuse>0.85 0.25 0.15 1</diffuse></material></visual></link></model>
<model name="marca_meta"><static>true</static><pose>2.6 0 0.002 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.06 2 0.003</size></box></geometry><material><ambient>0.1 0.75 0.2 1</ambient><diffuse>0.1 0.75 0.2 1</diffuse></material></visual></link></model>
<model name="robo"><pose>0 0 0 0 0 0</pose>
<link name="chassi"><pose>0 0 0.16 0 0 0</pose>
<inertial><mass>2</mass><inertia><ixx>0.0258</ixx><iyy>0.0471</iyy><izz>0.0621</izz></inertia></inertial>
<collision name="corpo"><geometry><box><size>0.5 0.35 0.18</size></box></geometry></collision>
<visual name="corpo"><geometry><box><size>0.5 0.35 0.18</size></box></geometry><material><ambient>0.05 0.3 0.8 1</ambient><diffuse>0.05 0.3 0.8 1</diffuse></material></visual>
<sensor name="distancia_frontal" type="gpu_lidar"><pose>0.25 0 0.03 0 0 0</pose><topic>/desafio/scan</topic><update_rate>20</update_rate><always_on>true</always_on><visualize>false</visualize><lidar><scan><horizontal><samples>3</samples><resolution>1</resolution><min_angle>-0.01</min_angle><max_angle>0.01</max_angle></horizontal></scan><range><min>0.02</min><max>10</max><resolution>0.001</resolution></range></lidar></sensor>
<sensor name="contato_corpo" type="contact"><always_on>true</always_on><update_rate>50</update_rate><topic>/desafio/contato</topic><contact><collision>corpo</collision><topic>/desafio/contato</topic></contact></sensor>
</link>
<link name="roda_esquerda"><pose>0 0.22 0.1 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.000542</ixx><iyy>0.000542</iyy><izz>0.001</izz></inertia></inertial><collision name="roda"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="roda"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link>
<joint name="eixo_esquerda" type="revolute"><parent>chassi</parent><child>roda_esquerda</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
<link name="roda_direita"><pose>0 -0.22 0.1 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.000542</ixx><iyy>0.000542</iyy><izz>0.001</izz></inertia></inertial><collision name="roda"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="roda"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link>
<joint name="eixo_direita" type="revolute"><parent>chassi</parent><child>roda_direita</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
<link name="apoio"><pose>-0.18 0 0.05 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia></inertial><collision name="apoio"><geometry><sphere><radius>0.05</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="apoio"><geometry><sphere><radius>0.05</radius></sphere></geometry></visual></link>
<joint name="apoio_fixo" type="fixed"><parent>chassi</parent><child>apoio</child></joint>
<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>eixo_esquerda</left_joint><right_joint>eixo_direita</right_joint><wheel_separation>0.44</wheel_separation><wheel_radius>0.1</wheel_radius><topic>/desafio/cmd_vel</topic><odom_topic>/desafio/odom</odom_topic><odom_publish_frequency>50</odom_publish_frequency><min_linear_velocity>0</min_linear_velocity><max_linear_velocity>0.5</max_linear_velocity><min_angular_velocity>0</min_angular_velocity><max_angular_velocity>0</max_angular_velocity><min_linear_acceleration>-1</min_linear_acceleration><max_linear_acceleration>1</max_linear_acceleration></plugin>
</model></world></sdf>
